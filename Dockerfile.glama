# Metadata-only Glama health-test image. NEVER load real Etsy credentials into this image.
# This image starts the local stdio MCP for initialize/tools/list only.
# It is not a public multi-seller HTTP endpoint or a credential proxy.
FROM node:22-alpine
WORKDIR /app
COPY --chown=node:node package.json ./
COPY --chown=node:node src/ ./src/
COPY --chown=node:node bin/ ./bin/
COPY --chown=node:node config.example.json ./config.example.json
USER node
ENV ETSY_HUB_CONFIG=/app/config.example.json
ENV ETSY_MCP_READ_ONLY=1
CMD ["node", "bin/etsy-mcp.mjs"]
